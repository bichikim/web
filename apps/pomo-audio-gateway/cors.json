{
  "rules": [
    {
      "allowed": {
        "headers": ["content-type"],
        "methods": ["PUT"],
        "origins": [
          "http://localhost:3100",
          "http://localhost:3200",
          "http://localhost:3300",
          "http://localhost:3400",
          "https://pomofi.io",
          "https://www.pomofi.io"
        ]
      },
      "exposeHeaders": ["etag"],
      "maxAgeSeconds": 3600
    }
  ]
}

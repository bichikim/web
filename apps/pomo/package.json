{
  "name": "@apps/pomo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:compress-focus-room": "node scripts/compress-focus-room-scenes.mjs",
    "assets:create-mouths": "node scripts/create-focus-room-mouth-assets.mjs",
    "blender:export": "blender --background blender/character-studio.blend --python blender/export_glb.py",
    "blender:open": "blender blender/character-studio.blend",
    "build": "pnpm run build:web",
    "build:apps-in-toss-ssg": "cross-env POMO_BUILD_TARGET=apps-in-toss vite build",
    "build:apps-in-toss-package": "pnpm run prepare:apps-in-toss-package && ait build",
    "build:web": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "vite dev --host",
    "licenses:list": "node scripts/list-licenses.mjs",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "prebuild:apps-in-toss-package": "node scripts/reset-apps-in-toss-output.mjs",
    "prepare:apps-in-toss-package": "pnpm run build:apps-in-toss-ssg && node scripts/prepare-apps-in-toss-output.mjs",
    "preview:apps-in-toss-ssg": "vite preview --config preview.config.ts --host --outDir .output/public",
    "preview:web": "node .output/server/index.mjs",
    "text-mood:train": "node scripts/text-mood/train.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.0.3",
    "@babylonjs/core": "9.18.0",
    "@babylonjs/loaders": "9.18.0",
    "@huggingface/transformers": "4.2.0",
    "@kobalte/core": "^0.13.11",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "@unocss/reset": "catalog:",
    "@vercel/functions": "^3.9.3",
    "class-variance-authority": "catalog:",
    "cross-env": "catalog:",
    "dexie": "^4.4.4",
    "drizzle-orm": "^0.45.2",
    "h3": "catalog:",
    "libopus-wasm": "0.2.0",
    "media-chrome": "^4.19.2",
    "nitro": "catalog:",
    "onnxruntime-web": "1.23.2",
    "openai": "^7.4.0",
    "pixi.js": "^8.19.0",
    "solid-js": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.33",
    "@types/node": "catalog:",
    "@winter-love/unocss-config": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-kit": "^0.31.10",
    "jiti": "catalog:",
    "rollup": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}

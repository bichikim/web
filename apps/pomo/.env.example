# 애플리케이션 쿼리에는 pooled URL을 사용한다.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# 마이그레이션에는 direct URL을 사용한다.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Neon 콘솔에서 Auth를 활성화한 branch의 서버 endpoint다.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
# Pomo 도메인에 저장하는 세션 캐시 쿠키 서명값이다. 최소 32자여야 한다.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# 앱인토스 콘솔에서 발급한 mTLS PEM 인증서와 개인 키다.
# Vercel에서는 줄바꿈을 \\n 문자열로 저장해도 런타임에서 복원한다.
POMO_TOSS_MTLS_CERT=-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----
POMO_TOSS_MTLS_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----
# 토스 로그인 연결 해제 콜백에 콘솔이 보내도록 설정한 Basic Authorization 헤더 전체 값이다.
# unlink 콜백을 받지 않으면 생략해도 된다.
POMO_TOSS_CALLBACK_AUTHORIZATION=Basic replace-with-base64-credentials

# 읽기 전용 외부 캘린더 OAuth 애플리케이션 자격 증명이다.
GOOGLE_CALENDAR_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-google-oauth-client-secret
MICROSOFT_CALENDAR_CLIENT_ID=replace-with-microsoft-oauth-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=replace-with-microsoft-oauth-client-secret
# `openssl rand -base64 32`로 만든 OAuth 토큰 AES-256-GCM 암호화 키다.
POMO_CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# 앱인토스·데스크톱 빌드가 연결할 API origin이다. 생략하면 https://www.pomofi.io를 사용한다.
POMO_PUBLIC_ORIGIN=https://www.pomofi.io

# 배포별 CSP 템플릿이다. {{SCRIPT_SOURCES}}, {{STYLE_SOURCES}}, {{CONNECT_SOURCES}}를 사용할 수 있다.
POMO_CONTENT_SECURITY_POLICY_TEMPLATE=default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src {{SCRIPT_SOURCES}} 'wasm-unsafe-eval'; style-src {{STYLE_SOURCES}}; style-src-attr 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob: https://storage.pomofi.io; worker-src 'self' blob:; connect-src {{CONNECT_SOURCES}}; manifest-src 'self'
# Worker CSP 템플릿에서는 {{CONNECT_SOURCES}}를 사용할 수 있다.
POMO_WORKER_CONTENT_SECURITY_POLICY_TEMPLATE=default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src {{CONNECT_SOURCES}}

# 유료 음원 재생 토큰을 검증하는 Cloudflare Worker의 공개 origin이다.
POMO_AUDIO_GATEWAY_ORIGIN=https://audio.pomofi.io
# Pomo 서버와 Worker에 동일하게 저장하는 HMAC 비밀값이다. 최소 32 bytes여야 한다.
POMO_PLAYBACK_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Pomo 서버가 검증한 공개 앨범 커버를 pomofi-audio R2에 저장하는 설정이다.
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
POMO_PUBLIC_ASSETS_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
POMO_PUBLIC_ASSETS_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
POMO_PUBLIC_ASSETS_R2_BUCKET=pomofi-audio
POMO_PUBLIC_ASSETS_ORIGIN=https://storage.pomofi.io

# Pomo 서버가 비공개 유료 음원 버킷의 업로드 URL을 발급하고 업로드 결과를 검증하는 설정이다.
POMO_PAID_AUDIO_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
POMO_PAID_AUDIO_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
POMO_PAID_AUDIO_R2_BUCKET=pomofi-paid-audio
POMO_PAID_AUDIO_R2_PREFIX=

# 역사 콘텐츠 생성에 사용하는 서버 전용 OpenAI 설정이다.
OPENAI_API_KEY=sk-project-key
OPENAI_MODEL=gpt-5.6-luna
# none, minimal, low, medium, high, xhigh, max
OPENAI_REASONING_EFFORT=medium
# auto, default, flex, priority
OPENAI_SERVICE_TIER=default
OPENAI_WEBHOOK_SECRET=whsec_example

# Vercel Cron 요청을 인증하는 서버 전용 bearer secret이다.
CRON_SECRET=replace-with-a-long-random-secret

# Decoded service key from data.go.kr for the KMA short-term forecast API.
KMA_SERVICE_KEY=replace-with-decoded-public-data-service-key
OPENWEATHER_API_KEY=replace-with-openweather-key

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poffo",
  "version": "0.1.0",
  "identifier": "io.poffo.desktop",
  "build": {
    "beforeBuildCommand": "pnpm exec turbo run build --filter=@winter-love/poffo...",
    "beforeDevCommand": "pnpm run dev --host 127.0.0.1 --port 1421 --strictPort",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "center": true,
        "height": 900,
        "minHeight": 620,
        "minWidth": 800,
        "title": "Poffo",
        "width": 1440
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' blob: data:; img-src 'self' asset: http://asset.localhost blob: data: https:; media-src 'self' blob: data:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "캐릭터 모델링·애니메이션 편집기",
    "targets": ["dmg", "nsis"]
  }
}

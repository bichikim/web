{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Native menus and fullscreen controls for the Poffo desktop workspace.",
  "windows": ["main"],
  "permissions": [
    "core:path:allow-basename",
    "dialog:allow-open",
    "fs:allow-read-file",
    "core:menu:default",
    "core:resources:allow-close",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallpaper",
  "version": "0.1.0",
  "identifier": "io.winterlove.wallpaper",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430/",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "manager",
        "title": "Wallpaper 설정",
        "backgroundThrottling": "disabled",
        "visible": false,
        "width": 560,
        "height": 720,
        "minWidth": 400,
        "minHeight": 540
      }
    ],
    "security": {
      "capabilities": ["manager", "background", "widget", "codex-bubble", "storage-origin"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost blob: https://storage.pomofi.io https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co asset: http://asset.localhost",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "script-src": "'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/semantic-models/**/*",
          "$APPCACHE/conversation-models/**/*",
          "$APPCACHE/voice-assets/**/*.onnx"
        ]
      },
      "headers": {
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["../.cache/whisper-runtime/crispasr"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "licenses/dictation.txt": "dictation-runtime/LICENSE.txt",
      "../.cache/whisper-runtime/libraries/": "whisper-runtime/",
      "licenses/semantic-model.txt": "licenses/semantic-model.txt",
      "licenses/voice-model.txt": "licenses/voice-model.txt"
    }
  }
}

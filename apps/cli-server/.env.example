# HTTP 서버 포트 (미설정 시 기본 3040)
PORT=3040

# CLI 실행 파일 (PATH에서 찾음). 예: cursor
# 호출 형태: `{AGENT_CLI} [body.subcommand] [body.prompt]` — 서브커맨드는 선택(POST JSON, 생략 시 `{AGENT_CLI}`만 프롬프트 전달)
AGENT_CLI=agent

# 클라이언트 `workingDirectory` 기준 루트.
# body.workingDirectory가 "/"이면 이 경로를 사용 (미설정 시 process.cwd()).
AGENT_WORKSPACE_ROOT=/Users/bichi/apps

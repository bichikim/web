{
  "name": "@winter-love/solid-use",
  "version": "1.0.38",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bichikim/web.git",
    "directory": "packages/solid-use"
  },
  "files": [
    "dist/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --minify false",
    "prepare-build": "pnpm run build:dev",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@winter-love/utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "es-toolkit": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@winter-love/vite-lib-config": "workspace:*",
    "vite": "catalog:"
  }
}

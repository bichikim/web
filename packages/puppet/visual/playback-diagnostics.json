  "pixelInvestigation": {
    "observation": "The actual multipass Metal path can produce a one-unit difference in raw RGBA8 values when replaying an unchanged frame, including with an unchanged baseline Player. Canvas straight-alpha readback can show a larger channel delta. This is not specific to the optimized artifact.",
    "trackedInputs": "The trace records buffer checksums, uniform values and selected GL state at each draw. On multiple repeated frames with differing raw output, every recorded draw input snapshot matched and Worker Float32 words/render plans matched exactly. Intermediate texture contents and every GPU instruction are not captured.",
    "causeBoundary": "The variability was isolated to the multipass Metal rendering path in this environment. The exact internal driver/rasterization operation was not established; this report does not declare a generic Metal driver bug or prove every hardware rendering path is bit-identical.",
    "ablations": [
      {
        "test": "Eight known-gradient Canvas 2D controls, including repeated reads",
        "result": "No differing channels. A general getImageData noise explanation was not reproduced.",
        "evidence": "/private/tmp/puppet-pixel-diagnosis/probe.json"
      },
      {
        "test": "Read the WebGL framebuffer and compare GPU-backed and software-backed Canvas copies",
        "result": "Differences were present in the raw framebuffer too; switching Canvas copy mode alone did not remove them.",
        "evidence": "/private/tmp/puppet-pixel-diagnosis/order-probe.log"
      },
      {
        "test": "Disable GL DITHER",
        "result": "The multipass Metal variation remained.",
        "evidence": "/private/tmp/puppet-pixel-diagnosis/dither-probe.log"
      },
      {
        "test": "Promote shader lowp/mediump qualifiers to highp in the diagnostic browser only",
        "result": "The variation remained, so no production shader precision change was made.",
        "evidence": "/private/tmp/puppet-pixel-diagnosis/highp-probe.log"
      },
      {
        "test": "Standalone textured-quad WebGL control, 40 repeated draws",
        "result": "Stable. The observation is scoped to the actual multipass path, not all Metal/WebGL rendering.",
        "evidence": "/private/tmp/puppet-pixel-diagnosis/minimal-webgl.json"

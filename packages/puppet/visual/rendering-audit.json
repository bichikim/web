  "findings": [
    {
      "number": 1,
      "severity": "P2",
      "status": "fixed",
      "title": "Identical shader lifetimes retain unique source strings",
      "risk": "Repeated player initialization grows global shader metadata despite destroyed GPU objects.",
      "cause": "Pixi setProgramName appended a new lifetime suffix to identical source; createIdFromString retained every resulting full source in its global idHash.",
      "fix": "Reuse preprocessed text by normalized name, stage and actual source; retain separate program objects and distinct variants.",
      "source": "patches/pixi.js@8.22.0.patch:105",
      "regression": "visual/__tests__/gl-program.memory.integration.tsx",
      "before": "300 identical program create/destroy operations after warmup retained 2,901,640 JS bytes.",
      "after": "Same regression passes the 262,144-byte bound; independent live programs and source variants remain valid.",
      "evidence": "/private/tmp/puppet-render-audit-xkymfh9q/shader-before.log",
      "tradeoff": "Keep one text entry per actual shader variant, rather than per lifetime; GPU ownership is unchanged."
    },
    {
      "number": 2,
      "severity": "P2",
      "status": "fixed",
      "title": "Retired pooled batches retain destroyed texture inputs and historical IDs",
      "risk": "An old model can remain reachable through decoded images; texture ID tombstones grow with repeated sources.",
      "cause": "returnBatchToPool cleared only elements, leaving textures, batcher and bind-group references; BatchTextureArray.clear set old UID entries to null instead of removing them.",
      "fix": "Release borrowed inputs on return while retaining reusable batch capacity; delete expired ID keys.",
      "source": "patches/pixi.js@8.22.0.patch:86",
      "regression": [
        "visual/__tests__/create-player.memory.integration.tsx",
        "src/player/rendering/__tests__/batch-texture-array.spec.ts"
      ],
      "before": "With all other fixes present, reverting only batch return leaves 2 decoded images alive after destroy and full GC. The ID test leaves 100 historical keys.",
      "after": "Images become unreachable, ID count is zero, and another live player preserves identical pixels.",
      "evidence": [
        "/private/tmp/puppet-render-audit-xkymfh9q/image-before-final.log",
        "/private/tmp/puppet-render-audit-xkymfh9q/batch-before.log",
        "/private/tmp/puppet-render-audit-xkymfh9q/memory-final-complete.log"
      ],
      "tradeoff": "Pool capacity stays reusable; no global pool reset that could disturb other renderers."
    },
    {
      "number": 3,
      "severity": "P2",
      "status": "fixed",
      "title": "Texture bind-group cache outlives destroyed inputs",
      "risk": "Global cached groups and listeners on shared placeholder resources keep per-source metadata alive. Used by graphics in WebGL as well as WebGPU.",
      "cause": "getTextureBatchBindGroup stored groups in a global table without eviction when their source was destroyed.",
      "fix": "On the first input destruction, evict that group, remove other source listeners and destroy its bindings.",
      "source": "patches/pixi.js@8.22.0.patch:27",
      "regression": "visual/__tests__/bind-group.memory.integration.tsx",
      "before": "A WeakRef to the retired group remains alive after source destruction and full GC.",
      "after": "It is collected; another group sharing a surviving source retains its cache identity and resource.",
      "evidence": [
        "/private/tmp/puppet-render-audit-xkymfh9q/bind-group-before.log",
        "/private/tmp/puppet-render-audit-xkymfh9q/memory-final-complete.log"
      ],
      "tradeoff": "Only groups with destroyed inputs are evicted; live inputs retain cache reuse."
    }
  ],

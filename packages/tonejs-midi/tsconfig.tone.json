{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "node_modules/@tonejs/midi/src",
    "strict": false,
    "outDir": "es-tone",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["es2022", "dom"]
  },
  "include": ["node_modules/@tonejs/midi/src/**/*.ts"]
}

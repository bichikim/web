{
  "name": "@winter-love/sw",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/bichikim/web.git"
  },
  "bin": {
    "sw": "bin/index.js"
  },
  "files": [
    "dist/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "import": "./dist/sw.mjs"
    },
    "./*": "./*"
  },
  "scripts": {
    "build": "vite build",
    "prepare-build": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js build -r 'test/assets' -a '**/*' ./node_modules/sw.js",
    "test": "pnpm --dir ../.. exec vitest run --project=unit packages/sw/src --reporter=dot",
    "test:integration:build": "pnpm --dir ../.. run test:integration:build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.3",
    "@rollup/plugin-babel": "^6.1.0",
    "@types/serviceworker": "^0.0.111",
    "@typescript/typescript6": "catalog:",
    "@winter-love/vite-lib-config": "workspace:*",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "^4.1.5"
  }
}
